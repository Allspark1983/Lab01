# Paste your own Atlas Drivers connection string here, or use local MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=recipe_book
PORT=3000

# npm run setup replaces this placeholder with a random secret in .env.
TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: only needed for Lab 9. Keep your actual key in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Classroom default matches the handout: only /profile is protected.
# Set true to require a Bearer token for recipe/review writes and AI routes.
REQUIRE_AUTH_FOR_WRITES=false
